name     = YouTube (Music) Enhance - Anywhere
hostname = youtubei.googleapis.com, googlevideo.com, doubleclick.net, googlesyndication.com

# URL-level ad blocking
0, 0, ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break, 2
0, 0, ^https?:\/\/googleads\.g\.doubleclick\.net\/pagead\/, 2
0, 0, ^https?:\/\/pagead2\.googlesyndication\.com\/pagead\/, 2
0, 0, ^https?:\/\/[\w-]+\.doubleclick\.net\/.*\/ad, 2
0, 0, ^https?:\/\/static\.doubleclick\.net\/instream\/, 2

# Without the hot-hash header the server resends its hot config in the
# log_event response, which is where the response engine learns the current
# onesie key. Upstream drops the header only while no key is cached; a
# native rule cannot be conditional, so it is dropped on every log_event.
0, 2, ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event, x-youtube-hot-hash-data

# Maasea protobuf engine inside a Surge environment shim
1, 100, ^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$, 

# Maasea request engine: empty 200 when the client's onesie key is not the cached one
0, 100, ^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*, 

# Maasea local UMP engine: strips the ads inside the onesie initplayback stream
1, 100, ^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*, 

[Parameter]
1, 0, blockUpload, Block Upload Button, , true, "[true, false]"
1, 0, blockImmersive, Block Immersive Button, , true, "[true, false]"
1, 0, blockShorts, Block Shorts Button, , false, "[true, false]"
